<!--
  Wazuh rules for the same detections as the Sigma rules in rules/.
  Each rule is tested in CI with wazuh-logtest against the raw lines in
  tests/samples/ (the file names the expected rule in `wazuh_rule`).
  Custom rules hang off Wazuh's built-in parent rules (if_sid), because a
  new top-level rule is never reached once a built-in parent has matched.
-->
<group name="detection_engineering,">

  <!-- ssh_failed_password. Built-in parents seen in wazuh-logtest 4.9.2:
       5760 = "sshd: authentication failed" (existing user),
       5710 = attempt to log in with a non-existent user.
       5716 is kept for older rule sets that use it for the same message. -->
  <rule id="100110" level="5">
    <if_sid>5760, 5716, 5710</if_sid>
    <match>Failed password for </match>
    <description>SSH failed password (Sigma: ssh_failed_password)</description>
    <mitre>
      <id>T1110.001</id>
    </mitre>
    <group>authentication_failed,</group>
  </rule>

  <!-- ssh_bruteforce: 5+ failures from one source. Correlates on 100110. -->
  <rule id="100111" level="10" frequency="5" timeframe="60">
    <if_matched_sid>100110</if_matched_sid>
    <same_srcip />
    <description>SSH brute force from a single source (Sigma: ssh_bruteforce)</description>
    <mitre>
      <id>T1110.001</id>
    </mitre>
  </rule>

  <!-- ssh_password_spraying: failures for different users from one source. -->
  <rule id="100112" level="10" frequency="5" timeframe="600">
    <if_matched_sid>100110</if_matched_sid>
    <same_srcip />
    <different_field>dstuser</different_field>
    <description>SSH password spraying from a single source (Sigma: ssh_password_spraying)</description>
    <mitre>
      <id>T1110.003</id>
    </mitre>
  </rule>

  <!-- new_local_user. Built-in parent: 5902 = new user added (useradd decoder). -->
  <rule id="100120" level="8">
    <if_sid>5902</if_sid>
    <match>new user: </match>
    <description>New local user account created (Sigma: new_local_user)</description>
    <mitre>
      <id>T1136.001</id>
    </mitre>
  </rule>

  <!-- user_added_to_privileged_group. usermod has no built-in decoder or rule:
       100130 groups the custom usermod decoder; gpasswd lands on built-in 2961. -->
  <rule id="100130" level="3">
    <decoded_as>usermod</decoded_as>
    <description>usermod messages grouped</description>
  </rule>

  <rule id="100131" level="10">
    <if_sid>100130, 2961</if_sid>
    <regex type="pcre2">to (shadow )?group '?(sudo|wheel|admin|adm|root)'?$</regex>
    <description>User added to a privileged group (Sigma: user_added_to_privileged_group)</description>
    <mitre>
      <id>T1098</id>
    </mitre>
  </rule>

  <!-- sudo_root_shell. Built-in parents: 5403 = first time a user runs sudo
       (fires in every fresh logtest session), 5402 = sudo to root. -->
  <rule id="100140" level="8">
    <if_sid>5402, 5403</if_sid>
    <regex type="pcre2">COMMAND=(/usr)?/bin/(ba|z|da|k|c|tc|fi)?sh( -[il]+)?$|COMMAND=(/usr)?/bin/su( -| -l)?( root)?$</regex>
    <description>Interactive root shell via sudo (Sigma: sudo_root_shell)</description>
    <mitre>
      <id>T1548.003</id>
    </mitre>
  </rule>

  <!-- crontab_modified. Built-in parents: 2832 = crontab entry changed
       (REPLACE), 2830 = crontab group (END EDIT, LIST). -->
  <rule id="100150" level="7">
    <if_sid>2832, 2830</if_sid>
    <regex type="pcre2">\(\S+\) (REPLACE|END EDIT) \(\S+\)</regex>
    <description>User crontab modified (Sigma: crontab_modified)</description>
    <mitre>
      <id>T1053.003</id>
    </mitre>
  </rule>

</group>
